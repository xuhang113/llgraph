{
  "thought": {
    "enabled": true,
    "max_chars": 8000,
    "emit_plan_line": true,
    "use_builtin_fallback": true
  },
  "edits": {
    "prefer_search_replace": true,
    "require_unique_match": true,
    "persist_edits": true,
    "snapshot_on_first_edit": true
  },
  "llm": {
    "model": "claude-sonnet-4-6"
  },
  "writes": {
    "chunk_max_chars": 8000,
    "failures_before_hint": 2
  },
  "agent": {
    "max_turns": 100,
    "batch_tools_nudge_after": 3,
    "identical_tool_guard": true,
    "investigate": {
      "guard_parallel_when_literals": true,
      "outline_gate": false,
      "soft_close_after_rounds": 20
    }
  },
  "context": {
    "_docs": {
      "compress_strategy": "auto | legacy | cursor(已废弃,等同auto)。auto=接近满窗LLM摘要；出站不裁user轮，超长工具结果指针/预览；legacy=按keep_recent_turns保留尾段。"
    },
    "compress_strategy": "auto",
    "compress_during_react": true,
    "budget_source": "model",
    "context_fallback_max_tokens": 200000,
    "auto_compress_ratio": 0.85,
    "compress_trigger_max_tokens": 64000,
    "incremental_tool_prune": true,
    "keep_recent_tool_messages": 6,
    "dispatch_tool_chain_compress": true,
    "dispatch_keep_full_tool_messages": 6,
    "grep_context_lines": 5,
    "grep_max_inline_chars": 48000,
    "tool_prune_token_ratio": 0.7,
    "spill_hit_context_lines": 100,
    "dispatch_dedupe_read_paths": true,
    "keep_recent_turns": 2,
    "keep_recent_token_ratio": 0.25,
    "compress_model": null,
    "session_archive_on_compress": true,
    "compress_tool_mask_max_chars": 6000,
    "read_tool_mask_max_chars": 12000,
    "tool_result_max_chars": 12000,
    "read_tool_result_max_chars": 36000,
    "read_file_max_lines": 2000,
    "read_file_max_bytes": 600000,
    "tool_result_preview_lines": 40,
    "tool_result_preview_head_lines": 25,
    "spill_dir": ".llgraph/context/tool-results",
    "spill_enabled": true,
    "spill_exempt_tools": []
  },
  "shell": {
    "enabled": true,
    "timeout_sec": 120,
    "background_timeout_sec": 1800,
    "max_output_chars": 32000,
    "max_jobs": 4,
    "terminal_log_dir": ".llgraph/context/terminals",
    "log_commands": true
  },
  "logging": {
    "level": "info",
    "search_file": true,
    "retention_days": 30,
    "execution_log": true
  },
  "review": {
    "output_dir": "~/llgraph-review",
    "spec_paths": [
      "CONTRIBUTING.md"
    ],
    "exclude_prefixes": [
      ".cursor/",
      "node_modules/",
      ".llgraph/",
      ".git/"
    ]
  }
}